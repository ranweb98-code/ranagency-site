# Public by design: the publishable key ships to every browser; row level
# security in the database is what protects the data. Never add the
# service-role key to this project.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sends the contact-form lead email and the CRM invitation email.
RESEND_API_KEY=

# The site's chat assistant (server only, never NEXT_PUBLIC_). A free key from
# https://aistudio.google.com/apikey. Without it the chat opens but answers with
# a friendly "not available" and a WhatsApp link.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite).
GEMINI_MODEL=

# Digital contract signing (/admin/contracts, /sign/<token>) — server only.
# The anon-callable contract_* database functions refuse every call that does
# not carry this secret (see supabase/migrations/20261012100000_contracts.sql
# for the one-time SQL that registers its hash).
CONTRACT_RPC_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts the signing
# links stored in the database so you can copy or re-send them later.
CONTRACT_TOKEN_KEY=
# The first Grow payment link the client is sent to after signing.
GROW_PAYMENT_URL=
# Where signing links point (no trailing slash). Default https://napuch.co.il
CONTRACT_BASE_URL=
# Who gets the "contract signed" email. Default ranweb98@gmail.com
CONTRACT_OWNER_EMAIL=
