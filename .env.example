# Public by design: the publishable key ships to every browser; row level
# security in the database is what protects the data. Never add the
# service-role key to this project.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sends the contact-form lead email and the CRM invitation email.
RESEND_API_KEY=
